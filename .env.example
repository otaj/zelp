# Copy to `.env` (gitignored) and fill in Amazfit/Zepp credentials.
# Used by ./scripts/capture_screenshots.sh — never commit real values.

ZEPP_EMAIL=you@example.com
ZEPP_PASSWORD=your-password

# Optional: prefer this watch model name (substring match, case-insensitive).
# Examples: "GTR 4", "T-Rex Ultra", "Balance"
# ZELP_WATCH_NAME=GTR 4

# Optional: adb / Flutter device id when multiple are attached
# ZELP_DEVICE_ID=emulator-5554

# Optional toggles (true/false). Defaults shown.
# ZELP_FETCH_KEYS=false
# ZELP_REFRESH_CATALOG=true
# ZELP_CHECK_FIRMWARE=true
